# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (required) -----------------------------------------------------
# Project Settings → API. The publishable (or legacy "anon") key is safe to
# expose to browsers: Row Level Security protects every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: set this instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Microsite links (required) ------------------------------------------------
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Encrypts stored links so agents can copy them again. Changing it makes
# existing links uncopyable (they keep working for buyers).
MICROSITE_TOKEN_SECRET=

# Public origin used in links sent to buyers, e.g. https://homes.clannco.com
# Falls back to the request host (or the Vercel production URL) if unset.
NEXT_PUBLIC_SITE_URL=

# --- Secret key (optional on the server) ---------------------------------------
# Secret (or legacy service_role) key. Always needed by `npm run seed`.
# Add it to the server environment ONLY if you want team invitations or
# notification emails; the rest of the app never uses it. Never expose it to
# the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SECRET_KEY=

# --- Notification emails (optional; all three plus SUPABASE_SECRET_KEY) --------
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Clannco <alerts@yourdomain.com>"
EMAIL_FROM=
# At least 32 random characters:  openssl rand -hex 32
# Must match the Authorization header configured on the Supabase webhook.
NOTIFICATIONS_WEBHOOK_SECRET=

# --- Shared rate limiting (optional) -------------------------------------------
# Upstash Redis REST credentials. Without them limits are per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Seed script only ------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
# Optional E.164 number shown to buyers as the agent's WhatsApp contact
SEED_ADMIN_PHONE=

# --- End-to-end tests (optional) -----------------------------------------------
# The seeded admin account; enables tests/e2e/agent-workflow.spec.ts
E2E_EMAIL=
E2E_PASSWORD=
# E2E_BASE_URL=http://localhost:3000
